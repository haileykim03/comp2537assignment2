<%- include("templates/header") %>

<h1>Users</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Type</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% for (let i = 0; i < users.length; i++) { %>
            <%- include('templates/user', { user: users[i] }) %>
        <% } %>
    </tbody>
</table>

<%- include("templates/footer") %>