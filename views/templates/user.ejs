<tr>
    <td><%= user.name %></td>
    <td><%= user.email %></td>
    <td><%= user.user_type %></td>
    <td>
        <% if (user.user_type === 'admin') { %>
            <a href="/admin/demote/<%= user.email %>" class="btn btn-success btn-sm">Demote to User</a>
        <% } else { %>
            <a href="/admin/promote/<%= user.email %>" class="btn btn-danger btn-sm">Promote to Admin</a>
        <% } %>
    </td>
</tr>