<%- include("templates/header") %>

<h1>Hello, <%= name %>.</h1>

<div class="row">
    <% for (let i = 0; i < images.length; i++) { %>
        <div class="col-12 col-md-4 mb-3">
            <img src="/<%= images[i] %>" class="img-fluid" alt="Cat <%= i + 1 %>">
        </div>
    <% } %>
</div>

<a href="/logout" class="btn btn-secondary mt-3">Sign out</a>

<%- include("templates/footer") %>